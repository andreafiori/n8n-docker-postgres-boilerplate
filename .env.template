# ── General ──────────────────────────────────────────────
TZ=UTC

# ── PostgreSQL (shared by n8n & pgAdmin) ─────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=n8n
# Optional server tuning (uncomment to override)
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# ── n8n ⇄ Postgres connection ────────────────────────────
DB_POSTGRESDB_POOL_SIZE=10
DB_POSTGRESDB_CONNECTION_TIMEOUT=3000   # ms
DB_POSTGRESDB_SSL_ENABLED=false         # true only if Postgres has SSL enabled

# ── n8n editor ───────────────────────────────────────────
N8N_USER=mymail@example.com
N8N_PASSWORD=admin
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_RUNNERS_ENABLED=true
# MUST be false on Windows / Docker-Desktop hosts
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# ── pgAdmin ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=adminpass
